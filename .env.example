# All pipeline LLM calls go through OpenRouter (src/lib/anthropic.ts)
OPENROUTER_API_KEY=
OPENROUTER_APP_TITLE=kitescout
# optional per role, e.g. an OpenRouter preset: OPENROUTER_MODEL_ANALYSIS=@preset/kitescout-analysis
# OPENROUTER_MODEL_SCREENING= / OPENROUTER_MODEL_EXTRACTION= / OPENROUTER_MODEL_ANALYSIS= / OPENROUTER_MODEL_CABIN=
TAVILY_API_KEY=your_tavily_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
